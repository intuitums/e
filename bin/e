#!/bin/sh
# e launcher: runs the release binary, building it if absent.
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
root="$(cd "$(dirname "$self")/.." && pwd)"
bin="$root/target/release/e"
if [ ! -x "$bin" ]; then
    echo "building e…" >&2
    (cd "$root" && cargo build --release --quiet) || exit 1
fi
exec "$bin" "$@"
